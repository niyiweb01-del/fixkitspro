# Fixkit environment variables
# Vercel → Project → Settings → Environment Variables
# Apply to Production (and Preview if you use preview deploys), then Redeploy.

# Required for charges — Paystack Dashboard → Settings → API Keys & Webhooks
# Test mode: use sk_test_… / pk_test_…
# Live mode: use sk_live_… / pk_live_…
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Currency Paystack will CHARGE (converted from USD catalog prices at live FX).
PAYSTACK_CURRENCY=NGN

# Your live site origin (Paystack callback_url + CORS)
SITE_URL=https://your-domain.com

# Recommended: dedicated HMAC secret for download links
DOWNLOAD_SECRET=change-me-to-a-long-random-string

# Optional — contact / newsletter email (Resend)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=you@yourdomain.com
# CONTACT_FROM_EMAIL=Fixkit <noreply@yourdomain.com>
